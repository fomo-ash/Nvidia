POSTGRES_DB=fixproof
POSTGRES_USER=fixproof
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://fixproof:change-me-local-only@db:5432/fixproof
VITE_API_BASE_URL=http://localhost:8000
LLM_PROVIDER=mock
LOCAL_DEMO_ENABLED=false
OPERATOR_SECRET=change-me-local-operator-secret
SESSION_SIGNING_KEY=change-me-local-session-signing-key
SAMPLE_TARGET_UID=replace-with-kind-deployment-uid
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
GRAFANA_PORT=3000

# Live AI: set LLM_PROVIDER=groq or nebius and supply that provider's key.
# Keep real keys only in the ignored .env file.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Nebius Token Factory / NVIDIA Nemotron 70B
NEBIUS_API_KEY=mock-nebius-key
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# System-1 decisions: policy is local and makes no outbound request.
# Select jev for TypeSafe Jev or laya for a compatible HTTP service.
SYSTEM1_PROVIDER=policy

# When SYSTEM1_PROVIDER=jev, optionally try the compatible service before policy fallback.
LAYA_ENABLED=false
# Compose service URL. The host health endpoint is http://localhost:8003/health.
LAYA_BASE_URL=http://laya:8000
LAYA_API_KEY=

# TypeSafe Jev System-1 Decisions (https://console.typesafe.ai/ / https://jevtypesafeai.com/)
TYPESAFE_API_KEY=mock-typesafe-key
JEV_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# MCP & AI Service Endpoints
MCP_SERVER_URL=http://localhost:8002
AI_SERVICE_URL=http://localhost:8001
